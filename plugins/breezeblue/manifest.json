{
  "schemaVersion": 1,
  "id": "breezeblue",
  "name": "BreezeBlue",
  "version": "1.0.0",
  "author": "builtin",
  "homepage": "https://breezeblue.ai",
  "description": "每日领取 400 免费积分（北京时间 08:00 重置）",
  "license": "MIT",
  "auth": {
    "type": "cookie",
    "primaryCookie": "breeze_blue_session",
    "hintUrl": "https://breezeblue.ai/app/home"
  },
  "permissions": {
    "network": ["https://breezeblue.ai"],
    "hooks": false
  },
  "schedule": {
    "timezone": "Asia/Shanghai",
    "defaultTime": "08:10",
    "jitterSeconds": 240,
    "windowStart": "08:00",
    "windowEnd": "23:59"
  },
  "limits": {
    "timeoutMs": 45000,
    "maxAttempts": 3
  }
}
