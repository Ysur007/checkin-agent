# HTTP
PORT=8787
DATA_DIR=./data
LOG_LEVEL=info
TZ=Asia/Shanghai

# 32-byte base64 key. Leave empty to generate /data/app.key on first boot.
APP_KEY=

# If set, this becomes the first admin password (min 8 chars).
# If empty, the console asks you to set one on first visit.
ADMIN_PASSWORD=

# Set to 1 only when the console is served over HTTPS.
COOKIE_SECURE=0
