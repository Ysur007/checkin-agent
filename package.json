{
  "name": "checkin-agent",
  "private": true,
  "version": "0.2.9",
  "type": "module",
  "description": "Local-first check-in agent: browser login, encrypted cookie vault, plugin adapters",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:web": "vite",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "build": "npm run build:server && npm run typecheck:web && npm run build:web",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "test": "vitest run",
    "probe": "tsx src/cli/probe.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/static": "^8.0.3",
    "better-sqlite3": "^11.5.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.1.0",
    "pino": "^9.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "undici": "^7.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
